<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <parent>
        <groupId>oleg.sopilnyak.test</groupId>
        <artifactId>parent-project</artifactId>
        <version>0.10.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>business-logic</artifactId>
    <description>Business-Logic for students and courses of the school</description>

    <properties>
        <asciidoctorj-pdf.version>2.3.19</asciidoctorj-pdf.version>
        <asciidoctorj-diagram.version>3.0.1</asciidoctorj-diagram.version>
        <asciidoctorj-diagram-plantuml>1.2025.3</asciidoctorj-diagram-plantuml>
    </properties>

    <dependencies>
        <!-- Production stuff -->
        <dependency>
            <groupId>oleg.sopilnyak.test</groupId>
            <artifactId>micro-core</artifactId>
        </dependency>
        <dependency>
            <groupId>oleg.sopilnyak.test</groupId>
            <artifactId>authentication</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${map-struct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.5.1</version>
        </dependency>
        <!-- Testing stuff -->
        <dependency>
            <groupId>oleg.sopilnyak.test</groupId>
            <artifactId>micro-core</artifactId>
            <version>${project.application.version}</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>oleg.sopilnyak.test</groupId>
            <artifactId>persistence</artifactId>
            <version>${project.application.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>[4.,)</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>[1.,)</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>[8.0.,)</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <testCompilerArgument>-parameters</testCompilerArgument>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${map-struct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- PlantUML Diagrams generator -->
            <plugin>
                <!--
                    plantuml-generator: creates a puml file in target/generated-docs folder
                    Begin of plugin definition
                    generated during mvn test
                -->
                <artifactId>plantuml-generator-maven-plugin</artifactId>
                <groupId>de.elnarion.maven</groupId>
                <version>${de.elnarion.maven.version}</version>
                <executions>
                    <!--
                    UML Class Diagrams
                    -->
                    <execution>
                        <id>generate-common-business-logic-command-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CommonCommandModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.command.type.education</scanPackage>
                                <scanPackage>oleg.sopilnyak.test.service.command.type.organization</scanPackage>
                                <scanPackage>oleg.sopilnyak.test.service.command.type.profile</scanPackage>
                            </scanPackages>
                            <additionalPlantUmlConfigs>
                                <additionalPlantUmlConfig>left to right direction</additionalPlantUmlConfig>
                            </additionalPlantUmlConfigs>
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PUBLIC</maxVisibilityMethods>
                            <blacklistRegexp>.*Component</blacklistRegexp>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-common-core-command-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CoreCommandModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.command.type.core</scanPackage>
                            </scanPackages>
                            <!--                            <additionalPlantUmlConfigs>-->
                            <!--                                <additionalPlantUmlConfig>left to right direction</additionalPlantUmlConfig>-->
                            <!--                            </additionalPlantUmlConfigs>-->
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PUBLIC</maxVisibilityMethods>
                            <blacklistRegexp>.*(Module|.*NestedContext.*|.*NestedState.*)</blacklistRegexp>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-common-core-nested-command-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CoreNestedCommandModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.command.type.core.nested</scanPackage>
                            </scanPackages>
                            <additionalPlantUmlConfigs>
                                <additionalPlantUmlConfig>left to right direction</additionalPlantUmlConfig>
                            </additionalPlantUmlConfigs>
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PUBLIC</maxVisibilityMethods>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-core-implementation-command-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CoreCommandImplementationModel.puml</outputFilename>
                            <whitelistRegexp>
                                oleg.sopilnyak.test.service.command.*.*(SchoolCommandCache|MacroCommand|BasicCommand|ParallelCommandsTask|SequentialCommandsTask|RootCommand|CompositeCommand)
                            </whitelistRegexp>
                            <hideFields>true</hideFields>
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PROTECTED</maxVisibilityMethods>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-core-executable-implementation-command-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CoreExecutableCommandImplementationModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.command.executable.core.executor</scanPackage>
                            </scanPackages>
                            <blacklistRegexp>.*(Builder|State)</blacklistRegexp>
                            <hideFields>true</hideFields>
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PROTECTED</maxVisibilityMethods>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-core-executable-command-message-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>CoreExecutableCommandMessageModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.message</scanPackage>
                            </scanPackages>
                            <blacklistRegexp>.*(Builder|Payload|Direction|Extra)</blacklistRegexp>
                            <!--                            <hideFields>true</hideFields>-->
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <maxVisibilityMethods>PROTECTED</maxVisibilityMethods>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-business-command-message-class-diagram</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <useSmetana>true</useSmetana>
                            <outputDirectory>${project.basedir}/documentation/puml/class-diagrams</outputDirectory>
                            <outputFilename>BusinessExecutableCommandMessageModel.puml</outputFilename>
                            <scanPackages>
                                <scanPackage>oleg.sopilnyak.test.service.message.payload</scanPackage>
                            </scanPackages>
                            <blacklistRegexp>.*(Builder|Extra)</blacklistRegexp>
                            <enableAsciidocWrapper>true</enableAsciidocWrapper>
                            <useShortClassNames>true</useShortClassNames>
                            <additionalPlantUmlConfigs>
                                <additionalPlantUmlConfig>left to right direction</additionalPlantUmlConfig>
                            </additionalPlantUmlConfigs>
                            <maxVisibilityMethods>PROTECTED</maxVisibilityMethods>
                        </configuration>
                    </execution>
                </executions>
                <!--
                    plantuml-generator: creates a puml file in target/generated-docs folder
                    End of plugin definition
                -->
            </plugin>
            <!-- AsciiDoctor Documentation generator -->
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>${asciidoctor-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-pdf</artifactId>
                        <version>${asciidoctorj-pdf.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram</artifactId>
                        <version>${asciidoctorj-diagram.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram-plantuml</artifactId>
                        <version>${asciidoctorj-diagram-plantuml}</version>
                    </dependency>
                </dependencies>

                <configuration>
                    <sourceDirectory>${project.basedir}/documentation/asciidoc</sourceDirectory>
                    <outputDirectory>${project.basedir}/documentation/html</outputDirectory>
                    <backend>html</backend>
                    <requires>
                        <require>asciidoctor-diagram</require>
                    </requires>
                </configuration>
                <executions>
                    <execution>
                        <id>convert-asciidoc-to-html</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
