[plantuml,BusinessExecutableCommandMessageModel.puml.png,png]
----
@startuml
!pragma layout smetana

left to right direction


class AccessCredentialsPayload {
	{field} +refreshToken : String
	{field} +token : String
}


class AuthorityPersonPayload {
	{field} +faculties : List
	{field} +title : String
}


abstract class BasePayload {
	{field} +id : Long
	{field} +original : BaseType
	{field} -originalType : String
}


abstract class BasePersonPayload {
	{field} +firstName : String
	{field} +gender : String
	{field} +lastName : String
	{field} +profileId : Long
}


abstract class BaseProfilePayload {
	{field} +email : String
	{field} +extras : Extra[]
	{field} +location : String
	{field} +phone : String
	{field} +photoUrl : String
	{method} +getExtra ( key : String ) : Optional
	{method} +getExtraKeys () : String[]
}


class CoursePayload {
	{field} +description : String
	{field} +name : String
	{field} +students : List
}


class FacultyPayload {
	{field} +courses : List
	{field} +dean : AuthorityPerson
	{field} +name : String
}


class PrincipalProfilePayload {
	{field} +permissions : Set
	{field} +role : Role
	{field} +signature : String
	{field} +username : String
	{method} +isPassword ( password : String ) : boolean
}


class StudentPayload {
	{field} +courses : List
	{field} +description : String
}


class StudentProfilePayload {
}


class StudentsGroupPayload {
	{field} +leader : Student
	{field} +name : String
	{field} +students : List
}




AccessCredentialsPayload --|>  BasePayload
AuthorityPersonPayload --|>  BasePersonPayload
BasePersonPayload --|>  BasePayload
BaseProfilePayload --|>  BasePayload
CoursePayload --|>  BasePayload
FacultyPayload --|>  BasePayload
PrincipalProfilePayload --|>  BaseProfilePayload
StudentPayload --|>  BasePersonPayload
StudentProfilePayload --|>  BaseProfilePayload
StudentsGroupPayload --|>  BasePayload


@enduml
